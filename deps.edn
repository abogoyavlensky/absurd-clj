{:deps {org.clojure/clojure {:mvn/version "1.12.6"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        org.postgresql/postgresql {:mvn/version "42.7.14"}
        metosin/jsonista {:mvn/version "1.0.2"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}}
 :paths ["src"]

 :aliases {:dev {:extra-paths ["dev"]}
           :test {:extra-paths ["test" "test/resources"]
                  :extra-deps {eftest/eftest {:mvn/version "0.6.0"}
                               cloverage/cloverage {:mvn/version "1.2.4"}
                               org.testcontainers/testcontainers-postgresql {:mvn/version "2.0.5"}
                               org.clojure/test.check {:mvn/version "1.1.3"}
                               org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                               ch.qos.logback/logback-classic {:mvn/version "1.6.5"}}
                  :exec-fn cloverage.coverage/run-project
                  :exec-args {:test-ns-path ["test"]
                              :src-ns-path ["src"]
                              :runner :eftest
                              :runner-opts {:multithread? false}}}

           :cross-sdk {:extra-paths ["cross-sdk/clj"]}

           :outdated {:extra-deps {com.github.liquidz/antq ^:antq/exclude {:mvn/version "2.11.1276"}}
                      :main-opts ["-m" "antq.core" "--no-diff"]}

           :build {:deps {io.github.abogoyavlensky/slim {:mvn/version "0.3.2"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default slim.lib
                   :exec-args {:version "0.5.0-alpha"
                               :lib io.github.abogoyavlensky/absurd-clj
                               :url "https://github.com/abogoyavlensky/absurd-clj"
                               :description "Clojure SDK for Absurd, a Postgres-native durable execution system"
                               :developer "Andrey Bogoyavlenskiy"}}}}
